{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "https://gosolarflash.com" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "functions": {
    "api/helius.js":              { "maxDuration": 30 },
    "api/token/scan.js":          { "maxDuration": 30 },
    "api/narratives.js":          { "maxDuration": 10 },
    "api/smart-money/sectors.js": { "maxDuration": 10 },
    "api/smart-money/clusters.js":{ "maxDuration": 10 },
    "api/alerts/stream.js":       { "maxDuration": 55 },
    "api/webhooks/helius.js":     { "maxDuration": 15 }
  }
}
